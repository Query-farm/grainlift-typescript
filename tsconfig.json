{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": { "#vgi-rpc-arrow": ["./node_modules/@query-farm/vgi-rpc/dist/arrow/impl-arrowjs/index.d.ts"] }
  },
  "include": ["src/**/*.ts"]
}
